{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm')){console.error('Use pnpm instead of npm/yarn');process.exit(1)}\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:server": "pnpm --filter @workspace/server run dev",
    "dev:frontend": "pnpm --filter @workspace/movie-hub run dev",
    "dev:sandbox": "pnpm --filter @workspace/mockup-sandbox run dev"
  },
  "private": true,
  "devDependencies": {
    "@esbuild/win32-x64": "^0.27.3",
    "@rollup/rollup-win32-x64-msvc": "^4.62.2",
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  }
}
